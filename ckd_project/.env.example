# Copy this file to .env and set values for your local environment.
DATABASE_URL=mysql+pymysql://YOUR_MYSQL_USER:YOUR_MYSQL_PASSWORD@127.0.0.1:3306/ckd_project
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_ORIGINS=http://localhost:5173
RESOURCE_DIR=rag/knowledge_base/raw
MAX_RESOURCE_MB=20
RAG_CHROMA_DIR=rag/chroma_store
RAG_MODEL_CACHE=models/embedding_cache
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_MIN_RELEVANCE=0.20
FRONTEND_BASE_URL=http://localhost:5173
# Optional password reset SMTP configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
PASSWORD_RESET_EXPIRE_MINUTES=30
